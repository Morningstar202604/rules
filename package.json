{
  "name": "agent-work-contract",
  "version": "1.7.4",
  "description": "Portable AI work contract with installable rules, skills, subagents, commands, and runtime hooks for coding agents.",
  "license": "MIT",
  "private": false,
  "bin": {
    "agent-work-contract": "install.js"
  },
  "scripts": {
    "test": "npm run selftest && npm run security:selftest",
    "selftest": "node core/hooks/selftest.js",
    "security:selftest": "node scripts/security_selftest.js",
    "install:zcode": "node install.js --tool zcode",
    "install:claude": "node install.js --tool claude",
    "verify": "node scripts/verify.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "core",
    "templates",
    "docs",
    "scripts",
    "install.js",
    "AGENTS.md",
    "README.md"
  ]
}
